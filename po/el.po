msgstr "Ελέγξτε πόσο συχνά επανυπολογίζεται η ηλιακή θέση."

msgid "Refresh interval (seconds)"
msgstr "Διάστημα ανανέωσης (δευτερόλεπτα)"

msgid "Lower values increase CPU usage slightly"
msgstr "Μικρότερες τιμές αυξάνουν ελαφρώς τη χρήση της CPU"

msgid "About"
msgstr "Σχετικά"

msgid "Solar position tracker inspired by WMSun"
msgstr "Εντοπιστής ηλιακής θέσης εμπνευσμένος από το WMSun"

msgid "Credits"
msgstr "Συντελεστές"

msgid "Original idea by Alberto Viniegra Ilarregi, created with Google's Antigravity and VSCodium"
msgstr "Αρχική ιδέα από τον Alberto Viniegra Ilarregi, δημιουργήθηκε με το Antigravity της Google και το VSCodium"

