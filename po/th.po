msgid "Elevation"
msgstr "มุมเงย"

msgid "Azimuth"
msgstr "มุมทิศ"

msgid "Sunrise"
msgstr "อาทิตย์ขึ้น"

msgid "Sunset"
msgstr "อาทิตย์ตก"

msgid "Solar Noon"
msgstr "เที่ยงสุริยคติ"

msgid "Day Length"
msgstr "ความยาววัน"

msgid "Settings"
msgstr "ตั้งค่า"

msgid "Coordinates not configured"
msgstr "ยังไม่ได้ตั้งค่าพิกัด"

msgid "Sun above horizon"
msgstr "ดวงอาทิตย์อยู่เหนือขอบฟ้า"

msgid "Sun below horizon"
msgstr "ดวงอาทิตย์อยู่ใต้ขอบฟ้า"

msgid "Polar day (sun does not set)"
msgstr "กลางวันขั้วโลก (ดวงอาทิตย์ไม่ตก)"

msgid "Polar night (sun does not rise)"
msgstr "กลางคืนขั้วโลก (ดวงอาทิตย์ไม่ขึ้น)"

msgid "N"
msgstr "น"

msgid "S"
msgstr "ต"

msgid "E"
msgstr "ตอ"

msgid "W"
msgstr "ตต"

msgid "Location"
msgstr "ตำแหน่ง"

msgid "Geographic Coordinates"
msgstr "พิกัดภูมิศาสตร์"

msgid "Enter your latitude and longitude in decimal degrees."
msgstr "ใส่พิกัดละติจูดและลองจิจูดในแบบทศนิยม"

msgid "Latitude"
msgstr "ละติจูด"

msgid "North positive, south negative (−90 … +90)"
msgstr "เหนือเป็นบวก ใต้เป็นลบ (−90 … +90)"

msgid "Longitude"
msgstr "ลองจิจูด"

msgid "East positive, west negative (−180 … +180)"
msgstr "ตะวันออกเป็นบวก ตะวันตกเป็นลบ (−180 … +180)"

msgid "General"
msgstr "ทั่วไป"

msgid "Refresh"
msgstr "รีเฟรช"

msgid "Control how often the solar position is recalculated."
msgstr "ตั้งค่าความถี่ในการคำนวณตำแหน่งดวงอาทิตย์ใหม่"

msgid "Refresh interval (seconds)"
msgstr "ช่วงเวลารีเฟรช (วินาที)"

msgid "Lower values increase CPU usage slightly"
msgstr "ค่าที่ต่ำลงจะทำให้ใช้ทรัพยากร CPU เพิ่มขึ้นเล็กน้อย"

msgid "About"
msgstr "เกี่ยวกับ"

msgid "Solar position tracker inspired by WMSun"
msgstr "ระบบติดตามตำแหน่งดวงอาทิตย์ที่ได้รับแรงบันดาลใจจาก WMSun"

msgid "Credits"
msgstr "เครดิต"

msgid "Original idea by Alberto Viniegra Ilarregi, created with Google's Antigravity and VSCodium"
msgstr "แนวคิดริเริ่มโดย Alberto Viniegra Ilarregi สร้างด้วย Antigravity ของ Google และ VSCodium"

