msgid "Elevation"
msgstr "גובה"

msgid "Azimuth"
msgstr "אזימוט"

msgid "Sunrise"
msgstr "זריחה"

msgid "Sunset"
msgstr "שקיעה"

msgid "Solar Noon"
msgstr "צהריים אמיתיים"

msgid "Day Length"
msgstr "אורך היום"

msgid "Settings"
msgstr "הגדרות"

msgid "Coordinates not configured"
msgstr "קואורדינטות לא מוגדרות"

msgid "Sun above horizon"
msgstr "השמש מעל האופק"

msgid "Sun below horizon"
msgstr "השמש מתחת לאופק"

