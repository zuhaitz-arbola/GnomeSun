msgid "Elevation"
msgstr "उन्नतांश"

msgid "Azimuth"
msgstr "दिगंश"

msgid "Sunrise"
msgstr "सूर्योदय"

msgid "Sunset"
msgstr "सूर्यास्त"

msgid "Solar Noon"
msgstr "सौर मध्याह्न"

msgid "Day Length"
msgstr "दिन की अवधि"

msgid "Settings"
msgstr "सेटिंग्स"

msgid "Coordinates not configured"
msgstr "निर्देशांक कॉन्फ़िगर नहीं किए गए हैं"

msgid "Sun above horizon"
msgstr "सूर्य क्षितिज के ऊपर है"

msgid "Sun below horizon"
msgstr "सूर्य क्षितिज के नीचे है"

msgid "Polar day (sun does not set)"
msgstr "ध्रुवीय दिन (सूर्य अस्त नहीं होता)"

msgid "Polar night (sun does not rise)"
msgstr "ध्रुवीय रात (सूर्य उदय नहीं होता)"

msgid "N"
msgstr "उ"

msgid "S"
msgstr "द"

msgid "E"
msgstr "पू"

msgid "W"
msgstr "प"

msgid "Location"
msgstr "स्थान"

msgid "Geographic Coordinates"
msgstr "भौगोलिक निर्देशांक"

msgid "Enter your latitude and longitude in decimal degrees."
msgstr "दशमलव डिग्री में अपनी अक्षांश और देशांतर दर्ज करें।"

msgid "Latitude"
msgstr "अक्षांश"

msgid "North positive, south negative (−90 … +90)"
msgstr "उत्तर सकारात्मक, दक्षिण नकारात्मक (−90 … +90)"

msgid "Longitude"
msgstr "देशांतर"

msgid "East positive, west negative (−180 … +180)"
msgstr "पूर्व सकारात्मक, पश्चिम नकारात्मक (−180 … +180)"

msgid "General"
msgstr "सामान्य"

msgid "Refresh"
msgstr "अद्यतन"

msgid "Control how often the solar position is recalculated."
msgstr "नियंत्रित करें कि सूर्य की स्थिति कितनी बार पुनर्गणना की जाती है।"

msgid "Refresh interval (seconds)"
msgstr "अद्यतन अंतराल (секунды)"

msgid "Lower values increase CPU usage slightly"
msgstr "कम मानों से सीपीयू का उपयोग थोड़ा बढ़ जाता है"

msgid "About"
msgstr "के बारे में"

msgid "Solar position tracker inspired by WMSun"
msgstr "WMSun से प्रेरित सौर स्थिति ट्रैकर"

msgid "Credits"
msgstr "श्रेय"

msgid "Original idea by Alberto Viniegra Ilarregi, created with Google's Antigravity and VSCodium"
msgstr "अल्बर्टो विनिगेरा इलारेगी का मूल विचार, Google के Antigravity और VSCodium के साथ बनाया गया"

