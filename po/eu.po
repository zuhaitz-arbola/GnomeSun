msgid "Elevation"
msgstr "Elebazioa"

msgid "Azimuth"
msgstr "Azimuta"

msgid "Sunrise"
msgstr "Egunsentia"

msgid "Sunset"
msgstr "Ilunabarra"

msgid "Solar Noon"
msgstr "Eguerdi solarra"

msgid "Day Length"
msgstr "Egunaren iraupena"

msgid "Settings"
msgstr "Ezarpenak"

msgid "Coordinates not configured"
msgstr "Koordenatuak konfiguratu gabe"

msgid "Sun above horizon"
msgstr "Eguzkia horizontearen gainean"

msgid "Sun below horizon"
msgstr "Eguzkia horizontearen azpian"

msgid "Polar day (sun does not set)"
msgstr "Egun polarra (eguzkia ez da sartzen)"

msgid "Polar night (sun does not rise)"
msgstr "Gau polarra (eguzkia ez da ateratzen)"

msgid "N"
msgstr "I"

msgid "S"
msgstr "H"

msgid "E"
msgstr "E"

msgid "W"
msgstr "M"

msgid "Location"
msgstr "Kokapena"

msgid "Geographic Coordinates"
msgstr "Koordenatu geografikoak"

msgid "Enter your latitude and longitude in decimal degrees."
msgstr "Sartu zure latitudea eta longitudea gradu hamartarretan."

msgid "Latitude"
msgstr "Latitudea"

msgid "North positive, south negative (−90 … +90)"
msgstr "Iparralderako positiboa, hegoalderako negatiboa (−90 … +90)"

msgid "Longitude"
msgstr "Longitudea"

msgid "East positive, west negative (−180 … +180)"
msgstr "Ekialderako positiboa, mendebalderako negatiboa (−180 … +180)"

msgid "General"
msgstr "Orokorra"

msgid "Refresh"
msgstr "Eguneratzea"

msgid "Control how often the solar position is recalculated."
msgstr "Eguzki posizioa zenbatero birkalkulatzen den kontrolatu."

msgid "Refresh interval (seconds)"
msgstr "Eguneratze-tartea (segundoak)"

msgid "Lower values increase CPU usage slightly"
msgstr "Balio txikiagoek PUZaren erabilera pixka bat handitzen dute"

msgid "About"
msgstr "Honi buruz"

msgid "Solar position tracker inspired by WMSun"
msgstr "WMSun-en inspiratutako eguzki-posizio jarraipen-tresna"

msgid "Credits"
msgstr "Kredituak"

msgid "Original idea by Alberto Viniegra Ilarregi, created with Google's Antigravity and VSCodium"
msgstr "Alberto Viniegra Ilarregiren jatorrizko ideia, Googleren Antigravity eta VSCodium bidez egina"

