msgstr "יום קוטבי (השמש לא שוקעת)"

msgid "Polar night (sun does not rise)"
msgstr "לילה קוטבי (השמש לא זורחת)"

msgid "N"
msgstr "צ"

msgid "S"
msgstr "ד"

msgid "E"
msgstr "מז"

msgid "W"
msgstr "מע"

msgid "Location"
msgstr "מיקום"

msgid "Geographic Coordinates"
msgstr "קואורדינטות גיאוגרפיות"

msgid "Enter your latitude and longitude in decimal degrees."
msgstr "הזן את קווי הרוחב והאורך במעלות עשרוניות."

msgid "Latitude"
msgstr "קו רוחב"

msgid "North positive, south negative (−90 … +90)"
msgstr "צפון חיובי, דרום שלילי (−90 … +90)"

msgid "Longitude"
msgstr "קו אורך"

