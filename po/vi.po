msgid "Elevation"
msgstr "Độ cao"

msgid "Azimuth"
msgstr "Góc phương vị"

msgid "Sunrise"
msgstr "Mặt trời mọc"

msgid "Sunset"
msgstr "Mặt trời lặn"

msgid "Solar Noon"
msgstr "Trưa mặt trời"

msgid "Day Length"
msgstr "Độ dài ngày"

msgid "Settings"
msgstr "Cài đặt"

msgid "Coordinates not configured"
msgstr "Chưa cấu hình tọa độ"

msgid "Sun above horizon"
msgstr "Mặt trời trên đường chân trời"

msgid "Sun below horizon"
msgstr "Mặt trời dưới đường chân trời"

msgid "Polar day (sun does not set)"
msgstr "Ngày cực (mặt trời không lặn)"

msgid "Polar night (sun does not rise)"
msgstr "Đêm cực (mặt trời không mọc)"

msgid "N"
msgstr "B"

msgid "S"
msgstr "N"

msgid "E"
msgstr "Đ"

msgid "W"
msgstr "T"

msgid "Location"
msgstr "Vị trí"

msgid "Geographic Coordinates"
msgstr "Tọa độ địa lý"

msgid "Enter your latitude and longitude in decimal degrees."
msgstr "Nhập vĩ độ và kinh độ của bạn bằng độ thập phân."

msgid "Latitude"
msgstr "Vĩ độ"

msgid "North positive, south negative (−90 … +90)"
msgstr "Bắc dương, nam âm (−90 … +90)"

msgid "Longitude"
msgstr "Kinh độ"

msgid "East positive, west negative (−180 … +180)"
msgstr "Đông dương, tây âm (−180 … +180)"

msgid "General"
msgstr "Chung"

msgid "Refresh"
msgstr "Làm mới"

msgid "Control how often the solar position is recalculated."
msgstr "Kiểm soát tần suất tính toán lại vị trí mặt trời."

msgid "Refresh interval (seconds)"
msgstr "Khoảng thời gian làm mới (giây)"

msgid "Lower values increase CPU usage slightly"
msgstr "Giá trị thấp hơn sẽ làm tăng nhẹ mức sử dụng CPU"

msgid "About"
msgstr "Giới thiệu"

msgid "Solar position tracker inspired by WMSun"
msgstr "Trình theo dõi vị trí mặt trời lấy cảm hứng từ WMSun"

msgid "Credits"
msgstr "Ghi nhận"

msgid "Original idea by Alberto Viniegra Ilarregi, created with Google's Antigravity and VSCodium"
msgstr "Ý tưởng gốc bởi Alberto Viniegra Ilarregi, được tạo bằng Antigravity của Google và VSCodium"

