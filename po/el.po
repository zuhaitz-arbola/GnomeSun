msgid "Elevation"
msgstr "Ύψος"

msgid "Azimuth"
msgstr "Αζιμούθιο"

msgid "Sunrise"
msgstr "Ανατολή"

msgid "Sunset"
msgstr "Δύση"

msgid "Solar Noon"
msgstr "Ηλιακό μεσημέρι"

msgid "Day Length"
msgstr "Διάρκεια ημέρας"

msgid "Settings"
msgstr "Ρυθμίσεις"

msgid "Coordinates not configured"
msgstr "Οι συντεταγμένες δεν έχουν ρυθμιστεί"

msgid "Sun above horizon"
msgstr "Ο ήλιος είναι πάνω από τον ορίζοντα"

msgid "Sun below horizon"
msgstr "Ο ήλιος είναι κάτω από τον ορίζοντα"

msgid "Polar day (sun does not set)"
msgstr "Πολική ημέρα (ο ήλιος δεν δύει)"

msgid "Polar night (sun does not rise)"
msgstr "Πολική νύχτα (ο ήλιος δεν ανατέλλει)"

msgid "N"
msgstr "Β"

msgid "S"
msgstr "Ν"

msgid "E"
msgstr "Α"

msgid "W"
msgstr "Δ"

msgid "Location"
msgstr "Τοποθεσία"

msgid "Geographic Coordinates"
msgstr "Γεωγραφικές Συντεταγμένες"

msgid "Enter your latitude and longitude in decimal degrees."
msgstr "Εισαγάγετε το γεωγραφικό πλάτος και μήκος σε δεκαδικές μοίρες."

msgid "Latitude"
msgstr "Γεωγραφικό πλάτος"

msgid "North positive, south negative (−90 … +90)"
msgstr "Βόρεια θετικό, νότια αρνητικό (−90 … +90)"

msgid "Longitude"
msgstr "Γεωγραφικό μήκος"

msgid "East positive, west negative (−180 … +180)"
msgstr "Ανατολικά θετικό, δυτικά αρνητικό (−180 … +180)"

msgid "General"
msgstr "Γενικά"

msgid "Refresh"
msgstr "Ανανέωση"

